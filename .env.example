# انسخ هذا الملف إلى .env واملأ القيم (لا ترفع .env إلى أي مكان عام)
NODE_ENV=production
PORT=3000
CLINIC_TZ=Africa/Cairo

# سر توقيع الجلسات: 32 حرفًا أو أكثر عشوائية. مثال للتوليد:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# حساب الإدارة: يُنشأ تلقائيًا عند أول تشغيل إذا لم يوجد مدير.
# بعد أول تشغيل ناجح احذف ADMIN_PASSWORD من هذا الملف.
ADMIN_NAME=مدير العيادة
ADMIN_EMAIL=
ADMIN_PASSWORD=

# خادم البريد (SMTP). بدونه تُطبع الرسائل في سجل السيرفر فقط.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="دكتور محمد حيدر <no-reply@yourdomain.com>"

# مجلد البيانات وقاعدة البيانات والنسخ الاحتياطية (اختياري)
# DATA_DIR=/var/lib/dental

# ===== للنشر على Vercel (ضعها في Project Settings > Environment Variables) =====
# قاعدة Turso (SQLite سحابية): turso db create dental ثم turso db show dental --url ثم turso db tokens create dental
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# سر المهمة اليومية للتذكيرات (أي نص عشوائي طويل)
CRON_SECRET=
